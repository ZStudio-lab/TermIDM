<Window
    x:Class="TermIDM.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TermIDM.Desktop"
    Title="TermIDM">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#FF080A0E" Padding="24">
        <Grid.Resources>
            <local:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <!-- Color Palette -->
            <SolidColorBrush x:Key="PageSurface" Color="#FF080A0E" />
            <SolidColorBrush x:Key="PanelSurface" Color="#FF0F1218" />
            <SolidColorBrush x:Key="PanelRaised" Color="#FF181C26" />
            <SolidColorBrush x:Key="PanelHover" Color="#FF1F2432" />
            <SolidColorBrush x:Key="LineBrush" Color="#FF252B3A" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF4A5268" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFEEF2FA" />
            <SolidColorBrush x:Key="TextSecondary" Color="#FF7A8499" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF06B6D4" />

            <LinearGradientBrush x:Key="ProgressBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF3B82F6" Offset="0" />
                <GradientStop Color="#FF06B6D4" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AddButtonBrush" StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#FF3B82F6" Offset="0" />
                <GradientStop Color="#FF2563EB" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="{StaticResource PanelRaised}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AddButtonBrush}" />
                <Setter Property="BorderBrush" Value="#FF2563EB" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="DownloadListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <DataTemplate x:Key="DownloadRowTemplate" x:DataType="local:DownloadItem">
                <Grid MinHeight="64" ColumnSpacing="18" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" MinWidth="160" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="2.1*" MinWidth="180" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="6" Padding="8,4"
                            Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="White" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />

                    <Grid Grid.Column="3" Height="44" VerticalAlignment="Center">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}"
                                     Background="{StaticResource PanelRaised}"
                                     Foreground="{StaticResource ProgressBrush}"
                                     CornerRadius="6" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" TextTrimming="CharacterEllipsis"
                                   Margin="8,0" IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock Grid.Column="4" Text="{Binding SpeedText}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="5" Text="{Binding EtaText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="18">
                <Border Width="38" Height="38" CornerRadius="10"
                        Background="#FF1E293B" BorderBrush="#FF334155" BorderThickness="1">
                    <Image x:Name="BrandLogoImage" Width="22" Height="22" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="TermIDM" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="VersionText" Text="Downloads" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="16,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D4;" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="TOTAL SPEED" FontSize="7" CharacterSpacing="30" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="TotalSpeedText" Text="0 B/s" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="AddUrl_Click"
                        ToolTipService.ToolTip="Add download" AutomationProperties.Name="Add download">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>

                <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="2,0,6,0" />

                <Button Style="{StaticResource ToolbarButtonStyle}" Click="Resume_Click"
                        ToolTipService.ToolTip="Resume selected download" AutomationProperties.Name="Resume download">
                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="Pause_Click"
                        ToolTipService.ToolTip="Pause selected download" AutomationProperties.Name="Pause download">
                    <FontIcon Glyph="&#xE769;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="Stop_Click"
                        ToolTipService.ToolTip="Stop selected download" AutomationProperties.Name="Stop download">
                    <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{StaticResource ErrorBrush}" />
                </Button>

                <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="2,0,6,0" />

                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ClearList_Click"
                        ToolTipService.ToolTip="Clear completed downloads" AutomationProperties.Name="Clear completed downloads">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                </Button>

                <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="2,0,6,0" />

                <Button Style="{StaticResource ToolbarButtonStyle}" Click="Options_Click"
                        ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation rail and download workspace -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Rail -->
            <Border Grid.Column="0" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="LIBRARY" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"
                                   CharacterSpacing="50" Margin="10,4,0,10" />

                        <Button x:Name="NavAll" Click="FilterAll_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE80F;" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="All downloads" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="AllCount" Grid.Column="2" Text="0" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavDownloading" Click="FilterActive_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Downloading" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                <Border Grid.Column="2" Background="#FF0C4A6E" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="DownloadingCount" Text="0" Foreground="{StaticResource InfoBrush}" FontSize="9" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="NavCompleted" Click="FilterCompleted_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Completed" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="CompletedCount" Grid.Column="2" Text="0" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavPaused" Click="FilterPaused_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE769;" FontSize="11" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Paused" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="PausedCount" Grid.Column="2" Text="0" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="8,12" />

                        <TextBlock Text="CATEGORIES" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"
                                   CharacterSpacing="50" Margin="10,0,0,10" />

                        <Button x:Name="NavGeneral" Click="FilterGeneral_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="#FFA78BFA" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="General" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavCompressed" Click="FilterCompressed_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="#FFFBBF24" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Compressed" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavDocuments" Click="FilterDocuments_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="#FF60A5FA" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Documents" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavVideos" Click="FilterVideos_Click" Style="{StaticResource NavButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="#FFF472B6" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Videos" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1" x:Name="NavScheduler" Click="Scheduler_Click" Style="{StaticResource NavButtonStyle}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="10,14,10,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE121;" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Scheduler" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="8" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Download Workspace -->
            <Border Grid.Column="1" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="18" Padding="10,4,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" MinWidth="160" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="2.1*" MinWidth="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FILE NAME" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="30" />
                        <TextBlock Grid.Column="1" Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="30" />
                        <TextBlock Grid.Column="2" Text="SIZE" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="30" />
                        <TextBlock Grid.Column="3" Text="PROGRESS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="30" />
                        <TextBlock Grid.Column="4" Text="SPEED" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="30" />
                        <TextBlock Grid.Column="5" Text="ETA" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="30" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource LineBrush}" />

                    <Grid Grid.Row="2">
                        <ListView x:Name="DownloadList" ItemTemplate="{StaticResource DownloadRowTemplate}"
                                  ItemContainerStyle="{StaticResource DownloadListItemStyle}" SelectionMode="Single"
                                  SelectionChanged="DownloadList_SelectionChanged" Background="Transparent" BorderThickness="0" />

                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="18" MaxWidth="420" IsHitTestVisible="False">
                            <Border Width="88" Height="88" CornerRadius="32"
                                    Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="34" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="Your downloads, at a glance" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyMessage" Text="Add a link to start a download. Progress, speed and remaining time will appear here."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ActiveSummary" Grid.Column="1" Text="0 active downloads" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
