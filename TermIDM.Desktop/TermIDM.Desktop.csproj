<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Default version when TermIDMVersion is not provided by build scripts -->
    <TermIDMVersion Condition="'$(TermIDMVersion)'==''">0.0.0</TermIDMVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Specify the target Windows runtime identifier for self-contained WinAppSDK builds. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AssemblyName>TermIDM</AssemblyName>
    <Version>$(TermIDMVersion)</Version>
    <AssemblyVersion>$(TermIDMVersion)</AssemblyVersion>
    <FileVersion>$(TermIDMVersion)</FileVersion>
    <ApplicationIcon>..\assets\termidm.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\VERSION" Link="VERSION" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\assets\termidm.ico" Link="assets\termidm.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\build\EngineBridge.dll" Link="EngineBridge.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\build\EngineBridge.dll')" />
    <EmbeddedResource Include="license-public-key.pem" LogicalName="TermIDM.Desktop.license-public-key.pem" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
  </ItemGroup>


</Project>
